        "--shell-font-weight-regular": "400",
        "--shell-font-weight-medium": "var(--tx-font-weight-medium, 500)",
        "--shell-font-weight-semibold": "var(--tx-font-weight-semibold, 600)"
      },
      "opticalCompensation": {
        "regular": { "light": 400, "dark": 400 },
        "medium": { "light": 500, "dark": 460 },
        "semibold": { "light": 600, "dark": 560 },
        "bold": { "light": 700, "dark": 660, "note": "Restricted to <=11px uppercase micro-labels or >=28px display numerals; never on prose." }
      }
    },
    "wrapping": {
      "headings": "balance",
      "prose": "pretty",
      "streamingLive": "auto"
    },
    "tracking": {
      "body": "0",
      "exemptions": [
        "<=11px uppercase micro-labels (0.04em - 0.08em)",
        ">=17px headings and display numerals (-0.01em)",
        "avatar initials (0.02em)"
      ]
    }
  },
  "materials": {
    "defaultSurface": "refraction",
    "supportedModes": ["refraction", "glass", "acrylic", "mica", "blur", "mask", "flat", "pure", "plain"],
    "refraction": {
      "rendererDefault": "css",
      "rendererOptions": ["css", "svg"],
      "svgGlassOpacityDefault": 0.3,
      "strengthDefault": 62,
      "angleDegDefault": -24,
      "profileDefault": "filmic",
      "profiles": {
        "soft": { "curveExponent": 1.15, "profileFactor": 0.92, "baseScaleRange": [-90, -240], "displaceRange": [0.14, 0.98] },
        "filmic": { "curveExponent": 1.65, "profileFactor": 1.0, "baseScaleRange": [-110, -360], "displaceRange": [0.22, 1.45] },
        "cinematic": { "curveExponent": 2.2, "profileFactor": 1.1, "baseScaleRange": [-140, -460], "displaceRange": [0.28, 1.85] }
      },
      "toneDefault": "balanced",
      "tones": {
        "mist": { "filterPrimaryTint": 24, "filterSecondaryTint": 16, "filterVeilTint": 42, "filterBaseTint": 16, "filterSaturationBoost": 1.22, "filterBrightnessBoost": 1.01 },
        "balanced": { "filterPrimaryTint": 34, "filterSecondaryTint": 24, "filterVeilTint": 28, "filterBaseTint": 10, "filterSaturationBoost": 1.4, "filterBrightnessBoost": 1.04 },
        "vivid": { "filterPrimaryTint": 44, "filterSecondaryTint": 34, "filterVeilTint": 18, "filterBaseTint": 6, "filterSaturationBoost": 1.58, "filterBrightnessBoost": 1.07 }
      },
      "filterLayerDefaults": {
        "blurPx": 10,
        "cardPresetBlurPx": 24,
        "acrylicBlurPx": 30,
        "filterSaturation": 1.5,
        "filterContrast": 1,
        "filterBrightness": 1,
        "opacity": 0.75,
        "edgeOpacityDefault": 0.08
      },
      "svgDisplacementDefaults": {
        "displace": 0.5,
        "distortionScale": -180,
        "redOffset": 0,
        "greenOffset": 10,
        "blueOffset": 20,
        "saturation": 1.8,
        "brightness": 70,
        "borderWidth": 0.07
      },
      "motionDegradation": {
        "fallbackDelayMs": 0,
        "settleDelayMs": 140,
        "pointerSpeedThresholdPxPerMs": 1.2,
        "lowBatteryLevel": 0.2,
        "surfaceMotionDurationMs": 299,
        "motionCoverOpacity": 0.55,
        "movingParamFloor": 0.28,
        "paramBlendDurationMs": 182,
        "maskReleaseDelayMs": 60,
        "maskReleaseDurationMs": 228,
        "edgeRevealDelayMs": 60,
        "edgeRevealDurationMs": 220,
        "layerFadeOutMs": 140,
        "layerFadeInDelayMs": 80,
        "layerFadeInMs": 220,
        "powerSavingOrReducedTarget": "blur",
        "minimalFrameBudgetTarget": "flat",
        "highContrastTarget": "flat"
      }
    }
  },
