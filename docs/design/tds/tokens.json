        "labelToFieldGapPx": 6,
        "formLabelColumnGapPx": 12
      }
    },
    "chrome": {
      "shell": {
        "--shell-sidebar-width": "260px",
        "--shell-window-controls-inset": "0px",
        "--shell-window-controls-height": "0px"
