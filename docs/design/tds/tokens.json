        "--tx-font-mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", \"Menlo\", \"Symbols Nerd Font Mono\", \"Symbols Nerd Font\", \"Maple Mono NF CN\", \"Maple Mono NF\", \"JetBrainsMono Nerd Font\", monospace"
      }
    },
    "weights": {
