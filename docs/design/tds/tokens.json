      "nonMacOverride": {
        "selector": ".platform-win32, .platform-linux",
        "tokens": {
          "--shell-window-controls-inset": "104px",
          "--shell-window-controls-height": "36px"
        }
      }
    },
    "elevation": {
      "lightSource": "top-left (x:y = 1:2)",
      "light": {
        "--tx-elevation-1": "1px 2px 4px rgba(0, 0, 0, 0.04)",
