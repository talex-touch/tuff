        "--shell-radius-sm": "6px",
        "--shell-radius-md": "10px",
        "--shell-radius-lg": "14px",
        "--shell-radius-xl": "20px",
        "--shell-radius-2xl": "24px",
        "--shell-radius-full": "999px"
      },
      "tuffex": {
        "--tx-border-radius-small": "2px",
        "--tx-border-radius-base": "4px",
        "--tx-border-radius-round": "20px",
        "--tx-border-radius-circle": "100%"
      },
      "squircle": {
        "smoothness": 0.6,
        "scale": 1.6,
        "superellipseExponent": 1.78,
        "concentricRule": "outer = inner + padding (when gap <= 8px)"
      }
    },
    "spacing": {
      "shell": {
        "--shell-space-1": "4px",
        "--shell-space-2": "8px",
