      { "role": "surface-dark-l2", "shell": "--shell-surface-2", "tuffex": "--tx-fill-color-light", "bui": "--tx-bui-hover", "status": "near-aligned", "note": "Shell #2c2c2e, TuffEx #262727, BUI #2b2b2b." },
      { "role": "accent-primary", "shell": "--shell-primary", "tuffex": "--tx-color-primary", "bui": "--tx-bui-accent", "status": "intentional-divergence", "note": "Shell uses Apple-leaning #2b7fd9 / #4e9ae6; TuffEx keeps Element-derived #409eff until M2 visual convergence." },
      { "role": "on-primary-dark", "shell": "--shell-on-primary", "tuffex": "--tx-color-on-primary", "status": "converged-in-hc-dark", "note": "Shell dark and TuffEx high-contrast dark share #0a2540 (5.24:1 / 8.28:1); TuffEx normal dark keeps #ffffff for legacy compatibility." },
      { "role": "semantic-hues", "shell": "--shell-{success,warning,danger,info}", "tuffex": "--tx-color-{success,warning,danger,info}", "status": "converged-in-high-contrast", "note": "Light/dark shell hues are calibrated for 11px chip ink on -soft composites (>=4.5:1); both html.contrast and html.dark.contrast re-point directly to --tx-color-* and -light-9." },
      { "role": "font-sans", "shell": "--shell-font-sans", "tuffex": "--tx-font-family", "status": "aliased" },
      { "role": "font-mono", "shell": "--shell-font-mono", "tuffex": "--tx-font-mono", "bui": "--tx-bui-font-mono", "status": "aliased" },
