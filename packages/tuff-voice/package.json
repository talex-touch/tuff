{
  "name": "@talex-touch/tuff-voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider-neutral speech recognition protocols and adapters for Tuff main runtime",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src"],
  "engines": { "node": ">=26.0.0" },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
