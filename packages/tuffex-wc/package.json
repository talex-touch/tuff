{
  "name": "@talex-touch/tuffex-wc",
  "type": "module",
  "version": "0.1.0",
  "description": "TuffEx Web Components powered by Vue 3.5 defineCustomElement with Light DOM theming and optional Shadow DOM support.",
  "author": "TalexDreamSoul <TalexDreamSoul@gmail.com>",
  "license": "(MIT AND Apache-2.0 AND ISC)",
  "homepage": "https://tuff.tagzxia.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "packages/tuffex-wc"
  },
  "keywords": [
    "tuff",
    "tuffex",
    "web-components",
    "custom-elements",
    "vue3",
    "ui-library"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "lint": "eslint --cache --max-warnings=0 --no-warn-ignored .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.27"
  },
  "dependencies": {
    "@floating-ui/vue": "catalog:",
    "@talex-touch/tuffex": "workspace:^",
    "@talex-touch/tuffex-core": "workspace:^",
    "@talex-touch/utils": "workspace:^",
    "dompurify": "^3.4.17",
    "gsap": "catalog:",
    "marked": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@vitejs/plugin-vue": "^6.0.7",
    "jsdom": "^26.1.0",
    "sass": "catalog:",
    "typescript": "catalog:dev",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7",
    "vue": "catalog:frontend"
  }
}
