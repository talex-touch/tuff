{
  "name": "@talex-touch/touch-api-lens-plugin",
  "version": "1.0.0",
  "private": false,
  "description": "Quick HTTP & cURL scratchpad with saved API collections, redacted previews, and secure token isolation for Tuff.",
  "author": "TalexTouch Team",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "keywords": [
    "tuff-plugin",
    "developer",
    "api",
    "http",
    "curl",
    "rest"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "manifest.json",
    "index.js",
    "assets/",
    "README.md"
  ],
  "dependencies": {},
  "engines": {
    "tuff": ">=261011"
  },
  "publishConfig": {
    "access": "public"
  },
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.touch-api-lens",
    "name": "touch-api-lens",
    "displayName": {
      "en": "API Lens",
      "zh": "API 透镜"
    },
    "sdkapi": 261011,
    "category": "developer",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": [
        "search.root-results"
      ],
      "optional": [
        "network.internet",
        "storage.plugin",
        "clipboard.write"
      ]
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  },
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "plugins/touch-api-lens"
  }
}
