{
  "name": "@talex-touch/touch-vscode-projects-plugin",
  "private": true,
  "version": "1.0.0",
  "description": "安全列出并打开 VS Code 最近项目",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "keywords": [
    "tuff-plugin",
    "utilities",
    "vscode",
    "projects",
    "workspace"
  ],
  "main": "./index.js",
  "engines": {
    "tuff": ">=261011"
  },
  "scripts": {
    "test": "node --test index.test.cjs",
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder"
  },
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.vscode-projects",
    "name": "touch-vscode-projects",
    "displayName": {
      "en": "VS Code Projects",
      "zh": "VS Code 最近项目"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": [
        "search.root-results"
      ],
      "optional": [
        "fs.read",
        "fs.index",
        "system.shell",
        "storage.plugin"
      ]
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "plugins/touch-vscode-projects"
  }
}
