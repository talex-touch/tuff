{
  "name": "@talex-touch/touch-ai-sessions-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "安全检索本地 AI 会话元数据并复制脱敏引用",
  "keywords": [
    "tuff-plugin",
    "utilities",
    "ai",
    "sessions"
  ],
  "license": "MIT",
  "main": "./index.js",
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  },
  "engines": {
    "tuff": ">=261011"
  },
  "packageManager": "pnpm@11.24.0",
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.ai-sessions",
    "name": "touch-ai-sessions",
    "displayName": {
      "en": "AI Sessions",
      "zh": "AI 会话"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": [
        "search.root-results"
      ],
      "optional": [
        "intelligence.basic",
        "fs.read",
        "clipboard.write"
      ]
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "plugins/touch-ai-sessions"
  }
}
