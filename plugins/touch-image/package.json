{
  "name": "@talex-touch/touch-image-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "快速修改图片分辨率、压缩并转换为 PNG、WebP、JPEG 或 ICO",
  "keywords": [
    "tuff-plugin",
    "utilities",
    "image",
    "converter",
    "compress"
  ],
  "license": "MIT",
  "main": "./index.js",
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  },
  "engines": {
    "tuff": ">=261011"
  },
  "packageManager": "pnpm@11.24.0",
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.image-tools",
    "name": "touch-image",
    "displayName": {
      "en": "Convert & Compress Images",
      "zh": "图片转换与压缩"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": ["search.root-results", "fs.read", "fs.write"],
      "optional": []
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  }
}
