{
  "name": "@talex-touch/touch-world-time-plugin",
  "version": "1.0.0",
  "private": false,
  "description": "World Clock across 50+ global cities, natural timezone conversion, golden-hours team meeting overlap planner, and pinned clocks for Tuff",
  "author": "TalexTouch Team",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "keywords": [
    "tuff-plugin",
    "productivity",
    "world-clock",
    "timezone",
    "meeting-planner",
    "dst"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "manifest.json",
    "index.js",
    "assets/",
    "README.md"
  ],
  "dependencies": {},
  "engines": {
    "tuff": ">=261011"
  },
  "publishConfig": {
    "access": "public"
  },
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.touch-world-time",
    "name": "touch-world-time",
    "displayName": {
      "en": "World Time",
      "zh": "世界时钟与会议规划"
    },
    "sdkapi": 261011,
    "category": "productivity",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": [
        "storage.plugin",
        "search.root-results"
      ],
      "optional": [
        "clipboard.write"
      ]
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  },
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "plugins/touch-world-time"
  }
}
