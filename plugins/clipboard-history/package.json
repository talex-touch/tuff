{
  "name": "@talex-touch/clipboard-history-plugin",
  "type": "module",
  "version": "1.2.0-beta.8",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Cross-platform clipboard history manager plugin for Tuff.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "plugins/clipboard-history"
  },
  "keywords": [
    "tuff-plugin",
    "utilities",
    "clipboard",
    "history"
  ],
  "scripts": {
    "build": "vite build && tuff builder && node ./scripts/assert-no-raw-channels.mjs",
    "dev": "vite --host 127.0.0.1 --port 3488",
    "lint": "eslint .",
    "preview": "vite preview --host 127.0.0.1 --port 3488",
    "sync:builtin": "node ./scripts/sync-builtin.mjs",
    "sync:external": "TUFF_CLIPBOARD_HISTORY_SYNC_EXTERNAL=1 node ./scripts/sync-builtin.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@talex-touch/tuffex": "workspace:^",
    "@talex-touch/utils": "workspace:^",
    "vue": "catalog:frontend"
  },
  "devDependencies": {
    "@talex-touch/tuff-cli": "workspace:^",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.6"
  },
  "tuff": {
    "category": "utilities",
    "displayName": {
      "en": "Clipboard History",
      "zh": "剪贴板历史记录"
    },
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "id": "com.tuffex.clipboard-history",
    "manifest": "./manifest.json",
    "name": "clipboard-history",
    "permissions": {
      "optional": [
        "storage.plugin",
        "system.shell"
      ],
      "required": [
        "clipboard.read",
        "clipboard.write",
        "fs.tfile",
        "system.applications"
      ]
    },
    "platforms": {
      "darwin": true,
      "linux": true,
      "win32": true
    },
    "schemaVersion": 1,
    "sdkapi": 261011,
    "surface": "webcontent"
  }
}
