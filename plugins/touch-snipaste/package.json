{
  "name": "@talex-touch/touch-snipaste-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Snipaste 快捷控制：截图、贴图、取色",
  "keywords": [
    "tuff-plugin",
    "utilities",
    "snipaste",
    "screenshot"
  ],
  "license": "MIT",
  "main": "./index.js",
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  },
  "engines": {
    "tuff": ">=261011"
  },
  "packageManager": "pnpm@11.24.0",
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.snipaste",
    "name": "touch-snipaste",
    "displayName": {
      "en": "Snipaste",
      "zh": "Snipaste"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": [
        "system.shell",
        "search.root-results"
      ],
      "optional": []
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "plugins/touch-snipaste"
  }
}
