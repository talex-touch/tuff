{
  "name": "@talex-touch/touch-emoji-symbols-plugin",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Emoji 与符号选择器：搜索并复制常用表情、颜文字、标点、货币与数学符号",
  "author": "TalexTouch Team",
  "license": "MIT",
  "keywords": [
    "tuff-plugin",
    "utilities",
    "emoji",
    "symbols",
    "kaomoji"
  ],
  "exports": {
    ".": "./index.js",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "files": [
    "manifest.json",
    "index.js",
    "assets/"
  ],
  "engines": {
    "tuff": ">=261011"
  },
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  },
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.emoji-symbols",
    "name": "touch-emoji-symbols",
    "displayName": {
      "en": "Emoji & Symbols",
      "zh": "Emoji 与符号"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": [
        "clipboard.write",
        "search.root-results"
      ],
      "optional": []
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  }
}
