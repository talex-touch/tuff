{
  "id": "com.tuffex.music",
  "name": "touch-music",
  "version": "1.0.0",
  "author": "TalexTouch Team",
  "sdkapi": 261011,
  "category": "media",
  "icon": {
    "type": "file",
    "value": "assets/logo.svg"
  },
  "description": "一款全平台音乐搜索与播放插件，通过受控网络权限检索曲目、专辑与逐字歌词。",
  "main": "index.js",
  "dev": {
    "enable": false,
    "address": "",
    "source": false
  },
  "permissions": {
    "required": ["network.internet"],
    "optional": ["clipboard.write"]
  },
  "permissionReasons": {
    "network.internet": "通过受控插件网络通道检索曲目、播放地址、封面与逐字歌词",
    "clipboard.write": "可选：支持在音乐面板与输入组件中复制歌曲信息或歌词文本"
  },
  "features": [
    {
      "id": "touch-music",
      "name": {
        "default": "音乐",
        "locales": {
          "zh-CN": "音乐",
          "en-US": "Touch Music"
        }
      },
      "desc": {
        "default": "搜索并播放音乐、查看逐字歌词",
        "locales": {
          "zh-CN": "搜索并播放音乐、查看逐字歌词",
          "en-US": "Search and play music with word-by-word lyrics"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": ["music", "音乐", "歌曲", "歌词", "player"],
      "push": false,
      "priority": 5,
      "acceptedInputTypes": ["text"],
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [
        {
          "type": "over",
          "value": ["music", "音乐", "touch-music"]
        }
      ],
      "interaction": {
        "type": "webcontent",
        "path": "/",
        "showInput": true,
        "allowInput": true,
        "forceMax": true
      }
    }
  ]
}
