{
  "name": "@talex-touch/touch-hosts-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "受限 Hosts 配置预览与确认写入",
  "keywords": [
    "tuff-plugin",
    "utilities",
    "hosts",
    "dns"
  ],
  "license": "MIT",
  "main": "./index.js",
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  },
  "engines": {
    "tuff": ">=261011"
  },
  "packageManager": "pnpm@11.24.0",
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.hosts",
    "name": "touch-hosts",
    "displayName": {
      "en": "Hosts",
      "zh": "Hosts 配置"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": ["search.root-results", "fs.read"],
      "optional": ["fs.write", "system.shell"]
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  }
}
