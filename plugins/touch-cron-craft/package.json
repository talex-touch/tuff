{
  "author": "TalexTouch Team",
  "dependencies": {},
  "description": "Cron Expression Humanizer, exact next-run calculator (local/UTC), bilingual natural-language generator, and presets for Tuff",
  "engines": {
    "tuff": ">=261011"
  },
  "exports": {
    ".": "./index.js",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "manifest.json",
    "index.js",
    "assets/",
    "README.md"
  ],
  "keywords": [
    "tuff-plugin",
    "developer",
    "cron",
    "crontab",
    "schedule",
    "utc"
  ],
  "license": "MIT",
  "main": "./index.js",
  "name": "@talex-touch/touch-cron-craft-plugin",
  "packageManager": "pnpm@11.24.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  },
  "tuff": {
    "category": "developer",
    "displayName": {
      "en": "Cron Craft",
      "zh": "Cron 定时助手"
    },
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "id": "com.tuffex.touch-cron-craft",
    "manifest": "./manifest.json",
    "name": "touch-cron-craft",
    "permissions": {
      "optional": [
        "clipboard.write"
      ],
      "required": [
        "search.root-results"
      ]
    },
    "platforms": {
      "darwin": true,
      "linux": true,
      "win32": true
    },
    "schemaVersion": 1,
    "sdkapi": 261011,
    "surface": "prelude"
  },
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "plugins/touch-cron-craft"
  }
}
