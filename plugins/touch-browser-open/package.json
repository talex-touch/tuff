{
  "name": "@talex-touch/touch-browser-open-plugin",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "浏览器打开：召唤框内直接识别网址与文字，支持多引擎直搜、热搜快捷入口与设置页",
  "author": "TalexTouch Team",
  "license": "MIT",
  "keywords": [
    "tuff-plugin",
    "utilities",
    "browser",
    "search",
    "url"
  ],
  "exports": {
    ".": "./index.js",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "files": [
    "manifest.json",
    "index.js",
    "settings.html",
    "assets/"
  ],
  "engines": {
    "tuff": ">=261011"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test index.test.cjs"
  },
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.browser.open",
    "name": "touch-browser-open",
    "displayName": {
      "en": "Open in Browser",
      "zh": "浏览器打开"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": [
        "system.shell",
        "network.internet",
        "search.root-results",
        "storage.plugin"
      ],
      "optional": [
        "clipboard.write"
      ]
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "webcontent",
    "manifest": "./manifest.json"
  }
}
