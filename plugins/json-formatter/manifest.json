{
  "id": "com.tuffex.json-formatter",
  "name": "json-formatter",
  "version": "1.0.9-beta.4",
  "author": "TalexTouch Team",
  "sdkapi": 261011,
  "category": "utilities",
  "icon": {
    "type": "file",
    "value": "assets/logo.svg"
  },
  "description": "一款全平台 JSON 工具，支持格式化、压缩、校验、转换与对比。",
  "dev": {
    "enable": false,
    "address": "",
    "source": false
  },
  "permissions": {
    "required": ["clipboard.read"],
    "optional": ["clipboard.write", "network.internet"]
  },
  "permissionReasons": {
    "clipboard.read": "读取剪贴板中的 JSON 文本作为格式化输入",
    "clipboard.write": "将格式化后的结果复制回系统剪贴板",
    "network.internet": "可选：已禁用 Monaco 远端 $schema 请求，插件自身不联网；仅保留可选声明以兼容 Monaco JSON Worker 内置源码"
  },
  "features": [
    {
      "id": "json-formatter-format",
      "name": {
        "default": "JSON格式化",
        "locales": {
          "zh-CN": "JSON格式化",
          "en-US": "Format JSON"
        }
      },
      "desc": {
        "default": "格式化选中的JSON文本或剪贴板内容",
        "locales": {
          "zh-CN": "格式化选中的JSON文本或剪贴板内容",
          "en-US": "Format the selected JSON text or the clipboard"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "acceptedInputTypes": ["text"],
      "platform": { "win32": true, "darwin": true, "linux": true },
      "commands": [
        {
          "type": "over",
          "value": ["json-formatter-format", "JSON格式化", "json", "格式化"]
        }
      ],
      "interaction": {
        "type": "webcontent",
        "path": "/json",
        "showInput": true,
        "allowInput": true,
        "forceMax": true
      }
    }
  ]
}
