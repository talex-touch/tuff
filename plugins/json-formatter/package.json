{
  "name": "@talex-touch/json-formatter-plugin",
  "type": "module",
  "version": "1.0.9-beta.4",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Cross-platform JSON workbench plugin for Tuff with formatting, querying, conversion, and diffing.",
  "keywords": [
    "tuff-plugin",
    "utilities",
    "json",
    "formatter",
    "yaml",
    "xml"
  ],
  "scripts": {
    "build": "vite build && tuff builder",
    "dev": "vite --port 5555",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.5.5",
    "@monaco-editor/loader": "^1.6.1",
    "@talex-touch/tuffex": "workspace:^",
    "@talex-touch/unplugin-export-plugin": "workspace:^",
    "@talex-touch/utils": "workspace:^",
    "@vueuse/core": "^14.4.0",
    "monaco-editor": "^0.57.0",
    "nprogress": "^0.2.0",
    "vue": "catalog:frontend",
    "vue-router": "^5.5.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@iconify-json/carbon": "^1.2.27",
    "@talex-touch/tuff-cli": "workspace:^",
    "@types/node": "catalog:dev",
    "@types/nprogress": "^0.2.3",
    "@unocss/eslint-config": "^66.10.2",
    "@unocss/reset": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^1.5.0",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "unplugin-vue-router": "^0.16.1",
    "vite": "^7.3.6",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.6"
  },
  "tuff": {
    "category": "utilities",
    "displayName": {
      "en": "Format JSON",
      "zh": "JSON格式化"
    },
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "id": "com.tuffex.json-formatter",
    "manifest": "./manifest.json",
    "name": "json-formatter",
    "permissions": {
      "optional": [
        "clipboard.write",
        "network.internet"
      ],
      "required": [
        "clipboard.read"
      ]
    },
    "platforms": {
      "darwin": true,
      "linux": true,
      "win32": true
    },
    "schemaVersion": 1,
    "sdkapi": 261011,
    "surface": "webcontent"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "plugins/json-formatter"
  }
}
