{
  "id": "com.tuffex.touch-calc-pad",
  "name": "touch-calc-pad",
  "version": "1.0.0",
  "author": "TalexTouch Team",
  "sdkapi": 261011,
  "category": "productivity",
  "icon": {
    "type": "file",
    "value": "assets/logo.svg"
  },
  "description": {
    "default": "智能计算板：自然语言数学、百分比、进制位运算、单位与带宽换算、分辨率比例与日期计算",
    "locales": {
      "zh-CN": "智能计算板：自然语言数学、百分比、进制位运算、单位与带宽换算、分辨率比例与日期计算",
      "en-US": "Soulver-style natural math, percentages, programmer bases, unit & transfer-time conversions, aspect ratios, and date arithmetic"
    }
  },
  "main": "index.js",
  "dev": {
    "enable": false,
    "address": "",
    "source": false
  },
  "permissions": {
    "required": [
      "storage.plugin",
      "search.root-results"
    ],
    "optional": [
      "clipboard.write"
    ]
  },
  "permissionReasons": {
    "storage.plugin": {
      "default": "保存最近计算历史以便快速复用",
      "locales": {
        "zh-CN": "保存最近计算历史以便快速复用",
        "en-US": "Persist recent calculation history locally for quick reuse"
      }
    },
    "clipboard.write": {
      "default": "将计算或换算结果复制到剪贴板",
      "locales": {
        "zh-CN": "将计算或换算结果复制到剪贴板",
        "en-US": "Copy calculated or converted results to your clipboard"
      }
    },
    "search.root-results": {
      "default": "Push touch-calc-pad entries into CoreBox root search results",
      "locales": {
        "zh-CN": "将 touch-calc-pad 结果推送到 CoreBox 根搜索结果",
        "en-US": "Push touch-calc-pad entries into CoreBox root search results"
      }
    }
  },
  "searchProviders": [
    {
      "id": "touch-calc-pad.calc-pad",
      "displayName": "智能计算板",
      "featureId": "calc-pad",
      "kind": "plugin",
      "owner": "official-plugin",
      "mode": "push",
      "priority": "fast",
      "defaultOrder": 86,
      "permissionScopes": [
        "root-results"
      ],
      "defaultState": "ask",
      "requiresUserConsent": true,
      "pushesToRootResults": true
    }
  ],
  "features": [
    {
      "id": "calc-pad",
      "name": {
        "default": "智能计算板",
        "locales": {
          "zh-CN": "智能计算板",
          "en-US": "Calc Pad"
        }
      },
      "desc": {
        "default": "自然语言数学、百分比、程序员进制、单位与传输时间、比例与日期运算",
        "locales": {
          "zh-CN": "自然语言数学、百分比、程序员进制、单位与传输时间、比例与日期运算",
          "en-US": "Natural math, percentages, programmer bases, unit/transfer/aspect conversions & date arithmetic"
        }
      },
      "icon": {
        "type": "file",
        "value": "assets/logo.svg"
      },
      "keywords": [
        "calc",
        "calcpad",
        "calculator",
        "math",
        "percent",
        "unit",
        "convert",
        "hex",
        "binary",
        "aspect",
        "bandwidth",
        "date",
        "计算",
        "计算器",
        "算式",
        "换算",
        "进制",
        "百分比"
      ],
      "push": true,
      "priority": 8,
      "acceptedInputTypes": [
        "text"
      ],
      "platform": {
        "win32": true,
        "darwin": true,
        "linux": true
      },
      "commands": [
        {
          "type": "over",
          "value": [
            "calc",
            "calcpad",
            "math",
            "unit",
            "conv",
            "计算",
            "算式",
            "换算"
          ]
        }
      ]
    }
  ]
}
