{
  "name": "@talex-touch/touch-calc-pad-plugin",
  "version": "1.0.0",
  "private": false,
  "description": "Soulver-style natural math, percentages, programmer bases, unit/transfer-time/aspect conversions, and date arithmetic for Tuff",
  "author": "TalexTouch Team",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "keywords": [
    "tuff-plugin",
    "productivity",
    "calculator",
    "math",
    "unit-converter",
    "programmer-calculator",
    "date-math"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "manifest.json",
    "index.js",
    "assets/",
    "README.md"
  ],
  "dependencies": {},
  "engines": {
    "tuff": ">=261011"
  },
  "publishConfig": {
    "access": "public"
  },
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.touch-calc-pad",
    "name": "touch-calc-pad",
    "displayName": {
      "en": "Calc Pad",
      "zh": "智能计算板"
    },
    "sdkapi": 261011,
    "category": "productivity",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": [
        "storage.plugin",
        "search.root-results"
      ],
      "optional": [
        "clipboard.write"
      ]
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  },
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  }
}
