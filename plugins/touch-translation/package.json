{
  "name": "@talex-touch/touch-translation-plugin",
  "type": "module",
  "version": "1.0.18-beta.4",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Multi-provider translation and screenshot OCR plugin for Tuff.",
  "keywords": [
    "tuff-plugin",
    "utilities",
    "translation",
    "ocr",
    "multi-provider"
  ],
  "scripts": {
    "build": "vite build && tuff builder",
    "dev": "vite --port 3733 --open",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@talex-touch/tuff-intelligence": "workspace:^",
    "@talex-touch/tuffex": "workspace:^",
    "@talex-touch/unplugin-export-plugin": "workspace:^",
    "@talex-touch/utils": "workspace:^",
    "@vueuse/core": "^14.4.0",
    "vue": "catalog:frontend",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@iconify-json/carbon": "^1.2.27",
    "@talex-touch/tuff-cli": "workspace:^",
    "@types/node": "catalog:dev",
    "@unocss/eslint-config": "^66.10.2",
    "@unocss/eslint-plugin": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^1.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.6"
  },
  "tuff": {
    "category": "utilities",
    "displayName": {
      "en": "Translate",
      "zh": "翻译"
    },
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "id": "com.tuffex.translation",
    "manifest": "./manifest.json",
    "name": "touch-translation",
    "permissions": {
      "optional": [
        "clipboard.write"
      ],
      "required": [
        "network.internet",
        "intelligence.basic",
        "storage.plugin"
      ]
    },
    "platforms": {
      "darwin": true,
      "linux": true,
      "win32": true
    },
    "schemaVersion": 1,
    "sdkapi": 261011,
    "surface": "webcontent"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "plugins/touch-translation"
  }
}
