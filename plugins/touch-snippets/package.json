{
  "name": "@talex-touch/touch-snippets-plugin",
  "private": true,
  "version": "1.0.1",
  "description": "统一片段库：搜索、保存并复制文本、代码与提示词模板",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "keywords": [
    "tuff-plugin",
    "utilities",
    "snippets",
    "templates",
    "clipboard"
  ],
  "main": "./index.js",
  "engines": {
    "tuff": ">=261011"
  },
  "scripts": {
    "test": "node --test index.test.cjs",
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder"
  },
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.snippets",
    "name": "touch-snippets",
    "displayName": {
      "en": "Snippets",
      "zh": "片段库"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": [
        "clipboard.write",
        "search.root-results",
        "storage.plugin"
      ],
      "optional": [
        "clipboard.read",
        "network.internet"
      ]
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "plugins/touch-snippets"
  }
}
