{
  "name": "@talex-touch/touch-quick-actions-plugin",
  "private": true,
  "version": "1.0.0",
  "description": "系统快捷动作：锁屏、静音与常用设置入口",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "keywords": ["tuff-plugin", "utilities", "quick-actions", "settings", "lock", "mute"],
  "main": "./index.js",
  "engines": {
    "tuff": ">=261011"
  },
  "scripts": {
    "test": "node --test index.test.cjs",
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder"
  },
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.quick-actions",
    "name": "touch-quick-actions",
    "displayName": {
      "en": "Quick Actions",
      "zh": "系统快捷动作"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": ["system.shell", "search.root-results"],
      "optional": []
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": false
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  }
}
