{
  "name": "@talex-touch/touch-orca-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "查看 Orca 运行状态并打开 Orca",
  "keywords": [
    "tuff-plugin",
    "utilities",
    "orca",
    "worktree",
    "terminal"
  ],
  "license": "MIT",
  "main": "./index.js",
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  },
  "engines": {
    "tuff": ">=261011"
  },
  "packageManager": "pnpm@11.24.0",
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.orca",
    "name": "touch-orca",
    "displayName": {
      "en": "Orca",
      "zh": "Orca"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": ["search.root-results"],
      "optional": ["system.applications"]
    },
    "platforms": {
      "win32": false,
      "darwin": true,
      "linux": false
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  }
}
