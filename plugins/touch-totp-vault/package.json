{
  "name": "@talex-touch/touch-totp-vault-plugin",
  "version": "1.0.0",
  "private": false,
  "description": "Local RFC 6238 / RFC 4226 2FA TOTP Authenticator Vault with WebCrypto HMAC-SHA1/SHA256/SHA512 and fail-closed host secret storage for Tuff",
  "author": "TalexTouch Team",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "keywords": [
    "tuff-plugin",
    "security",
    "utilities",
    "totp",
    "2fa",
    "authenticator",
    "otp",
    "mfa"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "manifest.json",
    "index.js",
    "assets/",
    "README.md"
  ],
  "dependencies": {},
  "engines": {
    "tuff": ">=261011"
  },
  "publishConfig": {
    "access": "public"
  },
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.touch-totp-vault",
    "name": "touch-totp-vault",
    "displayName": {
      "en": "2FA TOTP Vault",
      "zh": "2FA 动态令牌库"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": [
        "storage.plugin",
        "search.root-results"
      ],
      "optional": [
        "clipboard.write"
      ]
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  },
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  }
}
