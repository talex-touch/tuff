{
  "name": "@talex-touch/touch-text-tools-plugin",
  "private": true,
  "version": "1.0.0",
  "description": "文本转换工具：Base64/URL 编解码、JSON 美化、Hash",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "keywords": ["tuff-plugin", "utilities", "text-tools", "base64", "hash", "json"],
  "main": "./index.js",
  "engines": {
    "tuff": ">=261011"
  },
  "scripts": {
    "test": "node --test index.test.cjs",
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder"
  },
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.text-tools",
    "name": "touch-text-tools",
    "displayName": {
      "en": "Text Tools",
      "zh": "文本工具"
    },
    "sdkapi": 261011,
    "category": "utilities",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": ["clipboard.write", "search.root-results"],
      "optional": []
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  }
}
