{
  "name": "@talex-touch/touch-color-studio-plugin",
  "version": "1.0.0",
  "private": false,
  "description": "Color Lab for Tuff: HEX/RGB/RGBA/HSL/OKLCH converter, WCAG 2.1 AA/AAA contrast calculator, Tailwind v4 token matcher, harmony palettes & CSS gradients.",
  "author": "TalexTouch Team",
  "license": "MIT",
  "keywords": [
    "tuff-plugin",
    "design",
    "color",
    "oklch",
    "wcag",
    "contrast",
    "tailwind",
    "palette",
    "gradient"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "manifest.json",
    "index.js",
    "assets/",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../packages/tuff-cli/bin/tuff.js builder",
    "test": "node --test index.test.cjs"
  },
  "dependencies": {},
  "engines": {
    "tuff": ">=261011"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.24.0",
  "tuff": {
    "schemaVersion": 1,
    "id": "com.tuffex.touch-color-studio",
    "name": "touch-color-studio",
    "displayName": {
      "default": "Color Studio",
      "locales": {
        "zh-CN": "色彩工坊",
        "en-US": "Color Studio"
      }
    },
    "sdkapi": 261011,
    "category": "design",
    "icon": {
      "type": "file",
      "value": "assets/logo.svg"
    },
    "permissions": {
      "required": [
        "search.root-results"
      ],
      "optional": [
        "clipboard.write"
      ]
    },
    "platforms": {
      "win32": true,
      "darwin": true,
      "linux": true
    },
    "surface": "prelude",
    "manifest": "./manifest.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talex-touch/tuff.git",
    "directory": "plugins/touch-color-studio"
  }
}
