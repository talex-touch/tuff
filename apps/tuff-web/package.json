{
  "name": "@talex-touch/tuff-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone pure-SSG public website and product/SDK documentation for Tuff",
  "scripts": {
    "dev": "nuxt dev --port 3220 --host 127.0.0.1",
    "prepare": "nuxt prepare",
    "build:packages": "pnpm -C \"../../packages/utils\" run build && pnpm -C \"../../packages/tuffex-core\" run build && pnpm -C \"../../packages/tuffex\" run build",
    "generate:only": "NODE_OPTIONS=\"--max-old-space-size=8192\" nuxt generate",
    "stage:cf": "node scripts/stage-cf-assets.mjs",
    "generate": "NODE_OPTIONS=\"--max-old-space-size=8192\" nuxt generate && node scripts/stage-cf-assets.mjs",
    "build": "pnpm run generate",
    "preview": "npx serve .dist-cf",
    "preview:cf": "wrangler dev",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@floating-ui/vue": "catalog:",
    "@talex-touch/tuff-business": "workspace:*",
    "@talex-touch/tuffex": "workspace:*",
    "@talex-touch/tuffex-core": "workspace:*",
    "@talex-touch/utils": "workspace:*",
    "gsap": "catalog:",
    "h3": "catalog:",
    "katex": "catalog:",
    "marked": "catalog:",
    "mermaid": "catalog:",
    "micromark-extension-math": "catalog:",
    "nitropack": "catalog:",
    "ogl": "catalog:",
    "simplex-noise": "catalog:",
    "theme-colors": "catalog:",
    "vue-i18n": "11.4.16",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@iconify-json/carbon": "catalog:icons",
    "@iconify-json/logos": "catalog:",
    "@nuxtjs/color-mode": "catalog:build",
    "@nuxtjs/mdc": "catalog:",
    "@shikijs/engine-javascript": "^4.4.2",
    "@types/node": "catalog:dev",
    "@unocss/nuxt": "catalog:build",
    "@vue/compiler-sfc": "catalog:",
    "@vueuse/core": "catalog:frontend",
    "eslint": "catalog:dev",
    "nuxt": "catalog:build",
    "sass": "catalog:",
    "shiki": "^4.4.2",
    "typescript": "catalog:dev",
    "unocss": "catalog:build",
    "vitest": "catalog:",
    "vue": "catalog:frontend",
    "vue-tsc": "catalog:dev",
    "wrangler": "catalog:dev"
  }
}
