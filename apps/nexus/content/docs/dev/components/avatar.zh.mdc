### 头像组悬浮特效

:::TuffDemoWrapper{demo="AvatarGroupHoverDemo" code-lang="vue"}
---
code: |
  <template>
    <!-- 默认 lift：悬浮的头像上浮并盖过相邻头像 -->
    <TxAvatarGroup :overlap="12">
      <TxAvatar v-for="id in 5" :key="id" :src="`https://avatars.githubusercontent.com/u/${id}?v=4`" />
    </TxAvatarGroup>

    <!-- 整组悬浮时展开；spreadOverlap 为负值即留出间隙 -->
    <TxAvatarGroup :overlap="12" spread-on-hover :spread-overlap="-4">
      <TxAvatar v-for="id in 5" :key="id" :src="`https://avatars.githubusercontent.com/u/${id}?v=4`" />
    </TxAvatarGroup>

    <!-- 关闭悬浮特效 -->
    <TxAvatarGroup :overlap="12" hover-effect="none">
      <TxAvatar v-for="id in 5" :key="id" :src="`https://avatars.githubusercontent.com/u/${id}?v=4`" />
    </TxAvatarGroup>
  </template>
---
:::

