## Usage

### Basic
Each open edits a copy of `initialValues`; the dialog closes once the submit succeeds, and asks before closing on unsaved changes.
::::TuffDemoWrapper{demo="ModalFormBasicDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const open = ref(false)
  const member = ref({ name: 'Lin Xiao', email: 'lin@example.com', role: 'editor' })
  const roles = [
    { value: 'owner', label: 'Owner' },
    { value: 'editor', label: 'Editor' },
    { value: 'viewer', label: 'Viewer' },
  ]
  const rules = {
    name: { required: true, message: 'Enter a name' },
    email: { type: 'email', message: 'Enter a valid email address' },
  }

  // Until the promise settles, the dialog stays open and Save shows it is busy
  async function save(values) {
    await updateMember(values)
    member.value = values
  }
  </script>

  <template>
    <TxButton @click="open = true">Edit</TxButton>
    <TxModalForm
      v-model="open"
      title="Edit member"
      :initial-values="member"
      :rules="rules"
      @submit="save"
    >
      <template #default="{ model }">
        <TxFormItem label="Name" prop="name">
          <TuffInput v-model="model.name" />
        </TxFormItem>
        <TxFormItem label="Email" prop="email">
          <TuffInput v-model="model.email" type="email" />
        </TxFormItem>
        <TxFormItem label="Role" prop="role">
          <TxSelect v-model="model.role" :options="roles" />
        </TxFormItem>
      </template>
    </TxModalForm>
  </template>
