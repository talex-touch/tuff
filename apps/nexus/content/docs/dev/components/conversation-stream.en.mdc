# Conversation Stream

## Basic Usage

### Conversation Stream
::::TuffDemoWrapper{demo="ConversationStreamConversationStreamDemo" code-lang="vue"}
---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const items = ref([{ id: '1', text: 'Hello' }])

  async function loadOlder() {
    const older = await fetchOlder()
    items.value = [...older, ...items.value]
    return { hasMore: older.length > 0 }
  }
  </script>

  <template>
    <TxConversationStream
      :items="items"
      :item-key="item => item.id"
      :load-older="loadOlder"
      streaming
    >
      <template #item="{ item }">
        <div>{{ item.text }}</div>
      </template>
    </TxConversationStream>
  </template>
