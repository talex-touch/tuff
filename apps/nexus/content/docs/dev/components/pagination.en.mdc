  - name: pageChange
    type: '(page: number) => void'
    default: '-'
    description: Triggered when users navigate to another page
  - name: update:pageSize
    type: '(size: number) => void'
    default: '-'
    description: v-model page size update when the reader picks another size; the current page is left as it is
  - name: pageSizeChange
    type: '(size: number) => void'
    default: '-'
    description: Triggered when the reader picks another page size
---
::

