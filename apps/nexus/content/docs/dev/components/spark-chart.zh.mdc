## 用法

### SparkChart + ChartScrubber

::::TuffDemoWrapper{demo="SparkChartSparkChartDemo" code-lang="vue" title="可擦洗的趋势快照" description="平滑的双趋势、坐标轴与指针下的数值读数。"}
---
code: |
  <script setup lang="ts">
  import { computed, ref } from 'vue'

  const data = [0.22, 0.31, 0.45, 0.58, 0.51, 0.74, 0.91]
    .map((value, index) => ({ time: index * 5, value }))
  const activeIndex = ref<number | null>(null)
  const series = [{ id: 'trend', data }]
  const rows = computed(() => activeIndex.value === null
    ? []
    : [{ label: 'Trend', value: `${data[activeIndex.value]?.value ?? 0}` }])
  </script>

  <template>
    <TxChartScrubber
      :point-count="data.length"
      :active-index="activeIndex"
      :rows="rows"
      @update:active-index="activeIndex = $event"
    >
      <TxSparkChart
        :series="series"
        :active-index="activeIndex"
        x-axis
        y-axis
        grid
        aria-label="Trend snapshot"
      />
    </TxChartScrubber>
  </template>
---
