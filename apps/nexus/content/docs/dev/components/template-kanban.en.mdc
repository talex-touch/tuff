  import { reactive, ref } from 'vue'
  import TemplateFrame from './TemplateFrame.vue'

  type ColumnId = 'todo' | 'doing' | 'review' | 'done'

  // Each column is an ordered list of card ids; the card data lives apart.
  const board = reactive<Record<ColumnId, string[]>>({
    todo: ['k1', 'k2', 'k3'],
    doing: ['k4', 'k5', 'k6'],
    review: ['k7', 'k8'],
    done: ['k9', 'k10', 'k11'],
  })
  const picked = ref<string | null>(null)

  // Keyboard: Space picks up, arrows move, Space or Enter drops, Escape puts
  // the card back. The listener sits on the template root, not on window.
  function onKeydown(event: KeyboardEvent) {
    if (event.key === 'Escape' && picked.value) {
      event.preventDefault() // keep Escape from collapsing the TemplateFrame
      cancelPick()
    }
    // The other key branches are in the full demo source.
  }

  // Drag: the card is a native draggable; the drop slot is the nearest card midpoint.
  function onColumnDragOver(event: DragEvent, column: ColumnId) {
    event.preventDefault()
    setDropSlot(column, event.clientY)
  }
  function onColumnDrop(event: DragEvent, column: ColumnId) {
    event.preventDefault()
    commitDrop(column)
  }

  // Playback starts from @enter, never onMounted; reduced motion shows the end state.
  function play() {
    fillProgress()
  }
  defineExpose({ resetDemo })
