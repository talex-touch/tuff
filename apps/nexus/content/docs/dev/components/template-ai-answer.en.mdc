  // every reset and also keys the stream
  const state = reactive({ session, turns: [], items: [{ id: `${session}-tail`, kind: 'tail' }] })

  // Stop generating: the source ends here, and the element reveals what arrived
  function stop() {
    lastTurn.value.live = false
  }
