---
code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const state = ref<'idle' | 'working' | 'thinking' | 'success'>('idle')
  </script>

  <template>
    <TxMiko :state="state" size="md" />
    <TxMiko :state="state" size="lg" color="#199FFE" />
  </template>
---
