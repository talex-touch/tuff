            </TxTabItem>

            <TxTabItem name="security" icon-class="i-carbon-security">
              <template #name>安全</template>
              <TxGroupBlock name="登录" :collapsible="false">
                <TxBlockSlot title="双重验证" description="登录时再输入一次验证器中的代码">
                  <TuffSwitch v-model="twoFactor" aria-label="双重验证" />
                </TxBlockSlot>
              </TxGroupBlock>
            </TxTabItem>

            <TxTabItem name="sessions" icon-class="i-carbon-devices">
              <template #name>会话</template>
              <TxDataTable :columns="tableColumns" :data="sessions" row-key="id" table-layout="fixed" sticky-header>
                <template #cell-device="{ row }">
                  {{ row.device }}
                  <TxTag v-if="row.current" label="本机" variant="soft" />
                </template>
                <template #cell-actions="{ row }">
                  <TxIconButton v-if="!row.current" icon="i-carbon-trash-can" size="xs" label="删除会话" @click="askRemove(row.id)" />
                </template>
              </TxDataTable>
              <TxCard variant="dashed" :padding="16" :radius="14">
                <TxButton variant="danger" size="sm" @click="askRemoveOthers">删除其他会话</TxButton>
              </TxCard>
