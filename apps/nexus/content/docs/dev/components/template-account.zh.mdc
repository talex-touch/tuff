  <script setup lang="ts">
  import { reactive, ref, watch } from 'vue'
  import TemplateFrame from './TemplateFrame.vue'

  // 删除会话、关闭双重验证都先开弹窗，只有读者点击确认才生效；没有计时器替他确认
  const tab = ref('profile')
  const twoFactor = ref(true)
  const sessions = ref(seedSessions())
  const confirmOpen = ref(false)
  const profile = reactive({ displayName: '林澈', bio: '' })

  // 关闭时开关先保持开启，确认之后才真正关闭
  let allowTwoFactorOff = false
  watch(twoFactor, (next, previous) => {
    if (allowTwoFactorOff) {
      allowTwoFactorOff = false
      return
    }
    if (next || !previous)
      return
    twoFactor.value = true
    confirmOpen.value = true
  })
  </script>

