code: |
  <script setup lang="ts">
  import TxMermaidBlock from '@talex-touch/tuffex/stream-markdown'

  const content = ref('# Heading\n\nGenerating…')
  </script>

  <template>
    <TxStreamMarkdown
      :content="content"
      streaming
      :renderers="{ mermaid: TxMermaidBlock }"
