        <TxSidebarNav
          class="shell__sidebar"
          :model-value="section"
          :items="navItems"
          :groups="navGroups"
          :workspace="{ name: 'Tuff Labs', description: 'Team workspace · 5 people' }"
          action-label="New workflow"
          @update:model-value="section = $event"
          @action="createWorkflow"
        />
        <div class="shell__main">
          <header class="shell__topbar">
            <TxBreadcrumb :items="crumbs" @click="section = 'overview'" />
            <TxSearchInput v-model="filter" placeholder="Filter activity…" />
            <button type="button" aria-label="Open command palette" @click="paletteOpen = true">
              <TxKbd>⌘K</TxKbd>
            </button>
            <TxIconButton icon="i-carbon-notification" :label="`Notifications, ${unread} unread`" @click="trayOpen = !trayOpen" />
            <TxToastPanel :open="trayOpen" :stack="1">
              <!-- the latest notification -->
            </TxToastPanel>
          </header>

          <div class="shell__overview">
            <TxStatCard
              v-for="stat in stats"
              :key="stat.key"
              :value="stat.value"
              :label="stat.label"
              :icon-class="stat.icon"
              :insight="stat.insight"
            />
            <TxTimeline>
              <TxTimelineItem v-for="row in feed" :key="row.id" :title="row.title" :time="row.time" :color="row.color">
                {{ row.body }}
              </TxTimelineItem>
            </TxTimeline>
            <TxChartScrubber :point-count="24" :active-index="hour" :rows="hourRows" @update:active-index="hour = $event">
              <TxSparkChart :series="queries" :active-index="hour" />
            </TxChartScrubber>
          </div>
        </div>
        <TxCommandPalette v-model="paletteOpen" :commands="commands" @select="run" />
