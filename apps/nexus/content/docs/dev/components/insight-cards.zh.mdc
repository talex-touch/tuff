code: |
  <script setup lang="ts">
  import { ref } from 'vue'

  const page = ref(0)
  const pages = [
    { key: 'compare', prose: '表现最差的是 Rocky Road —— 下跌 6%。', suggestion: '要不要重新配比口味？' },
    { key: 'allocation', prose: '你在香草上压得很重 —— 它占了整箱的 72.5%。', suggestion: '只看季节限定会怎样？' },
