  enum FlowErrorCode {
    SENDER_NOT_ALLOWED = 'SENDER_NOT_ALLOWED',
    TARGET_NOT_FOUND = 'TARGET_NOT_FOUND',
    TARGET_OFFLINE = 'TARGET_OFFLINE',
    PAYLOAD_INVALID = 'PAYLOAD_INVALID',
    PAYLOAD_TOO_LARGE = 'PAYLOAD_TOO_LARGE',
