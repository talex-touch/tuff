# Ubuntu 24.04+ AppArmor profile for Tuff (.deb install, #213).
# Grants unprivileged user namespaces (userns) strictly to the installed Electron
# binary so Chromium's namespace sandbox stays active under
# kernel.apparmor_restrict_unprivileged_userns=1 without requiring --no-sandbox.
abi <abi/4.0>,
include <tunables/global>

profile "${executable}" "/opt/${sanitizedProductName}/${executable}" flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/${executable}>
}
