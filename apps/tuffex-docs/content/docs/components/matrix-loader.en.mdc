    <TxMatrixLoader state="searching" era="oled" size="lg" />
    <TxMatrixLoader state="searching" era="crt" size="lg" />
    <TxMatrixLoader state="searching" era="vfd" size="lg" />
    <TxMatrixLoader state="searching" era="dither" size="lg" />
    <TxMatrixLoader state="searching" era="lcd" size="lg" />
  </template>
---
